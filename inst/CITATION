# Title and version are read from DESCRIPTION, so they stay current.
year <- meta$`Date/Publication`
year <- if (is.null(year)) format(Sys.Date(), "%Y") else substr(year, 1, 4)

bibentry(
  bibtype  = "Manual",
  title    = paste0("surveyBurden: ", meta$Title),
  author   = person("Peter", "King"),
  year     = year,
  note     = paste("R package version", meta$Version),
  url      = "https://github.com/pmpk20/surveyBurden"
)
